@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam monochrome true
skinparam defaultFontColor #000000
hide circle
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ArrowColor #000000
skinparam ArrowThickness 1.5
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam classFontColor #000000
skinparam stereotypeFontColor #000000
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #000000
skinparam noteFontSize 14
skinparam titleFontSize 24
skinparam titleFontColor #000000
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
hide empty members
title Builder - validated, immutable order
left to right direction
class "Order.Builder" as Builder <<builder>> {
  - items : List<OrderLine>
  - discountStrategy : DiscountStrategy
  + customer(name) : Builder
  + fulfillment(mode) : Builder
  + addItem(line) : Builder
  + discount(strategy) : Builder
  + build() : Order
}
class Order <<product>> {
  - id : UUID
  - items : List<OrderLine>
  - pricing : Pricing
  - Order(builder)
  + items() : List<OrderLine>
  + pricing() : Pricing
}
class OrderLine <<record>> {
  + meal() : Meal
  + quantity() : int
  + lineTotal() : BigDecimal
}
interface DiscountStrategy
Builder ..> Order : creates after validation
Builder -down-> DiscountStrategy : selects
Order "1" *-down- "1..30" OrderLine : immutable copy
DiscountStrategy -[hidden]right- OrderLine
note right of Order
Constructor delegates pricing
to PricingCalculator.
end note
note bottom of Builder
Static nested builder in Order.
Required customer, fulfillment and items;
dine-in requires a valid table.
end note
@enduml
