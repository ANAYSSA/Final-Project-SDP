@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ArrowColor #59636E
skinparam ArrowThickness 1.5
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FAF7F0
skinparam classBorderColor #314047
skinparam classFontColor #223139
skinparam stereotypeFontColor #9A4F28
skinparam noteBackgroundColor #F8E9D6
skinparam noteBorderColor #D8B794
skinparam noteFontSize 14
skinparam titleFontSize 24
skinparam titleFontColor #223139
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #C8CED1
hide empty members
title Builder — validated, immutable order
left to right direction
class "Order.Builder" as Builder <<builder>> {
  - items : List<OrderLine>
  - discountStrategy : DiscountStrategy
  + customer(name) : Builder
  + fulfillment(mode) : Builder
  + addItem(line) : Builder
  + discount(strategy) : Builder
  + build() : Order
}
class Order <<product>> {
  - id : UUID
  - items : List<OrderLine>
  - pricing : Pricing
  - Order(builder)
  + items() : List<OrderLine>
  + pricing() : Pricing
}
class OrderLine <<record>> {
  + meal() : Meal
  + quantity() : int
  + lineTotal() : BigDecimal
}
interface DiscountStrategy
Builder ..> Order : creates after validation
Builder -down-> DiscountStrategy : selects
Order "1" *-down- "1..30" OrderLine : immutable copy
DiscountStrategy -[hidden]right- OrderLine
note right of Order
Constructor delegates pricing
to PricingCalculator.
end note
note bottom of Builder
Static nested builder in Order.
Required customer, fulfillment and items;
dine-in requires a valid table.
end note
@enduml
