@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam monochrome true
skinparam defaultFontColor #000000
hide circle
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ArrowColor #000000
skinparam ArrowThickness 1.5
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam classFontColor #000000
skinparam stereotypeFontColor #000000
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #000000
skinparam noteFontSize 14
skinparam titleFontSize 24
skinparam titleFontColor #000000
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
hide empty members
title Decorator - composable meal toppings
left to right direction
interface Meal <<component>> {
  + id() : String
  + name() : String
  + category() : MealCategory
  + price() : BigDecimal
}
abstract class BaseMeal <<base product>>
class Pizza <<concrete component>>
class Pasta <<concrete component>>
abstract class ToppingDecorator <<decorator>> {
  # wrapped : Meal
  - toppingName : String
  - extraPrice : BigDecimal
  + price() : BigDecimal
  + name() : String
}
class ExtraCheese <<concrete decorator>> {
  + ExtraCheese(meal)
}
class Mushrooms <<concrete decorator>> {
  + Mushrooms(meal)
}
class Olives <<concrete decorator>> {
  + Olives(meal)
}
class HerbsDecorator <<concrete decorator>> {
  + HerbsDecorator(meal)
}
Meal <|.. BaseMeal
BaseMeal <|-- Pizza
BaseMeal <|-- Pasta
Meal <|.. ToppingDecorator
ToppingDecorator o--> Meal : wraps one component
ToppingDecorator <|-- ExtraCheese
ToppingDecorator <|-- Mushrooms
ToppingDecorator <|-- Olives
ToppingDecorator <|-- HerbsDecorator
note bottom of ToppingDecorator
price = wrapped.price + extraPrice
Identity and category are delegated.
Metadata comes from ToppingType.
Drinks reject toppings.
end note
note bottom of ExtraCheese
Cheese +400 KZT; mushrooms +300;
olives +250; herbs +150 per decorated unit.
end note
@enduml
