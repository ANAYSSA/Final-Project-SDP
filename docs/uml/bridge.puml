@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam monochrome true
skinparam defaultFontColor #000000
hide circle
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ArrowColor #000000
skinparam ArrowThickness 1.5
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam classFontColor #000000
skinparam stereotypeFontColor #000000
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #000000
skinparam noteFontSize 14
skinparam titleFontSize 24
skinparam titleFontColor #000000
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
hide empty members
title Bridge - receipt purpose and output format
left to right direction
abstract class ReceiptDocument <<abstraction>> {
  - renderer : ReceiptRenderer
  + render(order, status) : String
  + contentType() : String
  # content(order, status) : ReceiptContent
}
class CustomerReceipt <<refined abstraction>> {
  # content(order, status) : ReceiptContent
}
class KitchenTicket <<refined abstraction>> {
  # content(order, status) : ReceiptContent
}
interface ReceiptRenderer <<implementor>> {
  + render(content) : String
  + contentType() : String
}
class TextReceiptRenderer <<concrete implementor>>
class HtmlReceiptRenderer <<concrete implementor>>
class JsonReceiptRenderer <<concrete implementor>>
class ReceiptContent <<record>> {
  + title() : String
  + lines() : List<String>
}
ReceiptDocument <|-- CustomerReceipt
ReceiptDocument <|-- KitchenTicket
ReceiptDocument o--> ReceiptRenderer : delegates formatting
ReceiptRenderer <|.. TextReceiptRenderer
ReceiptRenderer <|.. HtmlReceiptRenderer
ReceiptRenderer <|.. JsonReceiptRenderer
ReceiptDocument ..> ReceiptContent : produces
ReceiptRenderer ..> ReceiptContent : consumes
note bottom of ReceiptDocument
Two document purposes use any of three formats.
Purpose and format vary independently.
end note
@enduml
