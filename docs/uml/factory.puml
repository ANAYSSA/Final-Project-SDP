@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ArrowColor #59636E
skinparam ArrowThickness 1.5
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FAF7F0
skinparam classBorderColor #314047
skinparam classFontColor #223139
skinparam stereotypeFontColor #9A4F28
skinparam noteBackgroundColor #F8E9D6
skinparam noteBorderColor #D8B794
skinparam noteFontSize 14
skinparam titleFontSize 24
skinparam titleFontColor #223139
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #C8CED1
hide empty members
title Factory Method — menu products
left to right direction
abstract class MealFactory <<creator>> {
  + create(definition) : Meal
  # createMeal(definition) : Meal
}
class PizzaFactory <<concrete creator>>
class PastaFactory <<concrete creator>>
class DrinkFactory <<concrete creator>>
interface Meal <<product>> {
  + id() : String
  + name() : String
  + category() : MealCategory
  + price() : BigDecimal
}
abstract class BaseMeal {
  - definition : MenuDefinition
}
class Pizza <<concrete product>>
class Pasta <<concrete product>>
class Drink <<concrete product>>
class MenuCatalog <<creator registry>> {
  + create(id) : Meal
}
MealFactory <|-- PizzaFactory
MealFactory <|-- PastaFactory
MealFactory <|-- DrinkFactory
Meal <|.. BaseMeal
BaseMeal <|-- Pizza
BaseMeal <|-- Pasta
BaseMeal <|-- Drink
PizzaFactory ..> Pizza : creates
PastaFactory ..> Pasta : creates
DrinkFactory ..> Drink : creates
MenuCatalog --> MealFactory : chooses by category
note bottom of MealFactory
create() validates category, then calls
the overridden createMeal() method.
end note
@enduml
