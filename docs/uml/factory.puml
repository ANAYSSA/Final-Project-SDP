@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam monochrome true
skinparam defaultFontColor #000000
hide circle
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam ArrowColor #000000
skinparam ArrowThickness 1.5
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam classFontColor #000000
skinparam stereotypeFontColor #000000
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #000000
skinparam noteFontSize 14
skinparam titleFontSize 24
skinparam titleFontColor #000000
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #000000
hide empty members
title Factory Method - menu products
left to right direction
abstract class MealFactory <<creator>> {
  + create(definition) : Meal
  # createMeal(definition) : Meal
}
class PizzaFactory <<concrete creator>>
class PastaFactory <<concrete creator>>
class DrinkFactory <<concrete creator>>
interface Meal <<product>> {
  + id() : String
  + name() : String
  + category() : MealCategory
  + price() : BigDecimal
}
abstract class BaseMeal {
  - definition : MenuDefinition
}
class Pizza <<concrete product>>
class Pasta <<concrete product>>
class Drink <<concrete product>>
class MenuCatalog <<creator registry>> {
  + create(id) : Meal
}
MealFactory <|-- PizzaFactory
MealFactory <|-- PastaFactory
MealFactory <|-- DrinkFactory
Meal <|.. BaseMeal
BaseMeal <|-- Pizza
BaseMeal <|-- Pasta
BaseMeal <|-- Drink
PizzaFactory ..> Pizza : creates
PastaFactory ..> Pasta : creates
DrinkFactory ..> Drink : creates
MenuCatalog --> MealFactory : chooses by category
note bottom of MealFactory
create() validates category, then calls
the overridden createMeal() method.
end note
@enduml
